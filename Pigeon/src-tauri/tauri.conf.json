{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pigeon",
  "version": "0.2.1",
  "identifier": "com.pigeon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/alexanderszura/OrangePi-Media-Player/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzQzBDNTZFQ0ZEQTIwNjYKUldSbUlOclBic1hBRThVSVM4elFOd0ltUEVtdjNmQ0lMY05YTForVUZURmVJZWFubXg3WGxmcGwK"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pigeon",
        "width": 800,
        "height": 600,
        "fullscreen": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "https://image.tmdb.org",
          "https://images.igdb.com"
        ],
        "media-src": [
          "'self'",
          "asset:",
          "http://asset.localhost"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://api.themoviedb.org",
          "https://vidvault.ru"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "script-src": [
          "'self'"
        ]
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
