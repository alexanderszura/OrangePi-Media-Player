{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-set-fullscreen",
    "updater:default",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "**" }]
    }
  ],
  "remote": {
    "urls": [
      "asset://localhost/**"
    ]
  }
}